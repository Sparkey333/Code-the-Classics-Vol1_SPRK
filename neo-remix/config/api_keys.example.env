# Neo Remix — API keys for AI sprite generation
# Copy to neo-remix/.env and fill in at least one provider.
#
#   cp neo-remix/config/api_keys.example.env neo-remix/.env
#
# Provider priority (when --provider auto): openai > replicate > fal > stability

# --- OpenAI (recommended: best img2img edits for sprite refresh) ---
OPENAI_API_KEY=
# Optional: override model (default: gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Replicate (great pixel-art LoRAs, batch variation) ---
REPLICATE_API_TOKEN=
# Optional model slug (default: black-forest-labs/flux-schnell)
# REPLICATE_MODEL=black-forest-labs/flux-schnell

# --- Fal.ai (fast flux img2img) ---
FAL_KEY=
# FAL_MODEL=fal-ai/flux/dev/image-to-image

# --- Stability AI ---
STABILITY_API_KEY=
# STABILITY_ENGINE=stable-diffusion-xl-1024-v1-0

# --- Generation defaults ---
NEO_AI_VARIATIONS=4
NEO_AI_PROVIDER=auto
NEO_AI_RANDOMIZE=true
